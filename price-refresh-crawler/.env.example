# Export these before running; .env is not loaded automatically.
PRICE_REFRESH_REQUEST_DELAY=1
PRICE_REFRESH_CONNECT_TIMEOUT=5
PRICE_REFRESH_READ_TIMEOUT=20
PRICE_REFRESH_CONCURRENCY=1
PRICE_REFRESH_PAGE_SIZE=50
PRICE_REFRESH_MAX_UNIQUE=500
PRICE_REFRESH_MAX_PAGE_REQUESTS=100
# --dry-run reads this URL unless an offline DB fixture is supplied.
# --apply uses it for a session lock and price writes; requires a direct/session connection.
# Replace locally; never commit real credentials. Same variable as the AI app.
DATABASE_URL=postgresql://USER@localhost:5432/DB_NAME
PRICE_REFRESH_DB_CONNECT_TIMEOUT=5
PRICE_REFRESH_RECOMMENDATION_BATCH_SIZE=1000
# Required for --apply BEFORE any DB price writes. Leave unset for offline/dry-run.
PRICE_REFRESH_BACKEND_BASE_URL=
# JSON object of CONFIRMED authentication header names and full values.
# Authentication for PATCH /api/v1/internal/products is not yet verified locally.
# No assumed Bearer scheme or default credentials. Never commit real values.
PRICE_REFRESH_BACKEND_AUTH_HEADERS_JSON=
# Set lower if the backend's configured product limit is below 100 (range 1..100).
PRICE_REFRESH_BACKEND_BATCH_SIZE=100
PRICE_REFRESH_BACKEND_CONNECT_TIMEOUT=5
PRICE_REFRESH_BACKEND_READ_TIMEOUT=20
