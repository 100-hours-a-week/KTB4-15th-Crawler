# Export these before running; .env is not loaded automatically.
PRICE_REFRESH_REQUEST_DELAY=1
PRICE_REFRESH_CONNECT_TIMEOUT=5
PRICE_REFRESH_READ_TIMEOUT=20
PRICE_REFRESH_CONCURRENCY=1
PRICE_REFRESH_PAGE_SIZE=50
PRICE_REFRESH_MAX_UNIQUE=500
PRICE_REFRESH_MAX_PAGE_REQUESTS=100
# Only --dry-run without --stored-products-fixture reads this PostgreSQL URL.
# Replace locally; never commit real credentials. Same variable as the AI app.
DATABASE_URL=postgresql://USER@localhost:5432/DB_NAME
PRICE_REFRESH_DB_CONNECT_TIMEOUT=5
PRICE_REFRESH_RECOMMENDATION_BATCH_SIZE=1000
